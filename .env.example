# Copy to .env and fill in. .env is ignored by git.
RUTORRENT_HOST=https://seedbox.example.com/rutorrent/plugins/httprpc/action.php
RUTORRENT_USERNAME=your_username
RUTORRENT_PASSWORD=your_password

# Seconds between runs (300 = every 5 minutes)
INTERVAL=300

# Extra arguments for every run, e.g. --view to only preview without removing anything
EXTRA_ARGS=

# User/group the container runs as; must be able to write ./logs (see `id`)
PUID=1007
PGID=1007
